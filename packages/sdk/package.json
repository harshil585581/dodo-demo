{
  "name": "@dodo/sdk",
  "version": "1.0.0",
  "description": "Zero-dependency embeddable checkout SDK for Dodo Payments",
  "main": "./dist/dodo.cjs.js",
  "module": "./dist/dodo.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dodo.esm.js",
      "require": "./dist/dodo.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
